  <property name="styleSheet">
   <string notr="true">
/* TEXT NORMAL*/
QLabel{
font-size:11pt;
padding:1px;

}

/* PUSH BUTTON*/
QPushButton{
background-color:#494948;
color:white;
font-size: 16px;
}
QPushButton:hover{
font-weight:800;
background-color:#3a3a39;
}

QPushButton:pressed {
font-weight:400;
background-color:#2c2c2b;
}

/* CHECCK BOX CSS*/
QCheckBox {
    padding: 5px;
 font-size: 11pt;

}
QCheckBox::indicator {
    background-color: #F0F7F4;
    width: 15px;
    height: 15px;
    border: 2px solid #3a3a39;
    border-radius: 4px;
    transition: width 400ms ease-in-out, height 400ms ease-in-out, border 400ms ease-in-out;
}
QCheckBox::indicator:hover {
    width: 19px;         
    height: 19px;
   border: none;    
}
QCheckBox::indicator:checked {
    image: url(:/icons/check_3.png);
    border: 2px solid #3a3a39;
}
QCheckBox::indicator:checked:hover {
    border: none;
}
/*RADIO BUTTON CSS */
QRadioButton{
spacing:5px;
color:black;
font-size: 11pt;
}
QRadioButton::indicator{
width: 15px;
height:15px;
border: 2px solid #3a3a39;
border-radius: 9px;
background-color: #F0F7F4;
transition: background-color 400ms ease-in-out, border 400ms ease-in-out;
}
QRadioButton:indicator:hover{
border-color:none
}

QRadioButton:indicator:checked{
	image: url(:/icons/radio_2.png);
}

/* LINE EDIT	*/
QLineEdit{
background-color:#F0F7F4;
border: 1px solid #3a3a39;
border-radius: 3px;
padding:2px 4px;;
selection-background-color: #3a3a39;
transition: 400ms ease-in-out;
}
/* hover a nakliknutí */
QLineEdit:focus, QLineEdit:hover{
border:none;
}

/* SLIDER */
QSlider::groove:horizontal {
    height: 4px;
    background: #3a3a39;
    border-radius: 3px;

}

/* 2. Nevyplněná část (vpravo od úchytu) */
QSlider::add-page:horizontal {
    background: #F0F7F4 ;
    border-radius: 2px;
}

/* 3. Vyplněná část (vlevo od úchytu - ukazuje hodnotu) */
QSlider::sub-page:horizontal {
    background: #3a3a39;
    border-radius: 3px;
}

/* 4. Úchyt / Kolečko, za které se tahá */
QSlider::handle:horizontal {
    background: #F0F7F4;
    border: 3px solid #3a3a39 ;
    width: 6px;
    height: 6px;
         margin: -4px 0;           /* Vyrovnání: posune úchyt na střed lišty */
    border-radius:6px;              /* Udělá z úchytu kruh */
}

/* 5. Hover efekt pro úchyt */
QSlider::handle:horizontal:hover {
    background: #3a3a39;
    border: 3px solid #F0F7F4;
border-radius:6px;
}
</string>
